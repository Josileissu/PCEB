<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plugin de detalhamento estrutural para Revit 2025 / 2026 (.NET 8).

    Compilar:
      dotnet build -c Release -p:RevitVersion=2025
      dotnet build -c Release -p:RevitVersion=2026

    As DLLs da API são lidas da instalação do Revit (não precisa de NuGet).
    Se o Revit estiver em outra pasta:  -p:RevitInstallDir="D:\Autodesk\Revit 2025\"
    Para não copiar automaticamente para a pasta de Addins: -p:DeployToRevit=false
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>DEB.Revit</RootNamespace>
    <AssemblyName>DEB.Revit</AssemblyName>
    <Version>0.1.0</Version>

    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitInstallDir>
    <DeployToRevit Condition="'$(DeployToRevit)' == ''">true</DeployToRevit>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\R$(RevitVersion)\</OutputPath>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Núcleo comum com o plugin de CAD (regras de dobramento, bitolas, numeração...) -->
    <ProjectReference Include="..\DEB.Core\DEB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Padrões de apresentação do PCEB (fonte: Padroes\; convenção de nomes em docs/04_arquitetura/padroes_apresentacao.md) -->
    <EmbeddedResource Include="Padroes\*.json" LogicalName="DEB.Revit.Padroes.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Copia a DLL e o manifesto para %AppData%\Autodesk\Revit\Addins\<versão>\ -->
  <Target Name="DeployToRevitAddins" AfterTargets="Build" Condition="'$(DeployToRevit)' == 'true'">
    <PropertyGroup>
      <AddinDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</AddinDir>
    </PropertyGroup>
    <!-- Assina DEB.Revit.dll e DEB.Core.dll com o certificado "CN=PCEB DEB" do usuário, se existir (o Revit deixa de
         pedir "Sempre carregar" a cada build). Sem o certificado, segue sem assinar. Ver src/DEB.Revit/CLAUDE.md. -->
    <Exec ContinueOnError="true" Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$c = Get-ChildItem Cert:\CurrentUser\My -CodeSigningCert | Where-Object Subject -eq 'CN=PCEB DEB' | Select-Object -First 1; if ($c) { Get-Item '$(OutputPath)DEB.Revit.dll','$(OutputPath)DEB.Core.dll' | Set-AuthenticodeSignature -Certificate $c -HashAlgorithm SHA256 | Out-Null; Write-Host 'DLLs assinadas (PCEB DEB)' } else { Write-Host 'Sem certificado PCEB DEB: DLLs sem assinatura' }&quot;" />
    <ItemGroup>
      <_SdBuilt Include="$(OutputPath)*.dll;$(OutputPath)*.pdb;$(OutputPath)*.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_SdBuilt)" DestinationFolder="$(AddinDir)DEB.Revit\" SkipUnchangedFiles="true" />
    <!-- nome antigo (StructuralDetailer): remove para não carregar duas vezes (mesmo ClientId) -->
    <Delete Files="$(AddinDir)StructuralDetailer.addin" ContinueOnError="true" />
    <RemoveDir Directories="$(AddinDir)StructuralDetailer" ContinueOnError="true" />
    <Copy SourceFiles="DEB.Revit.addin" DestinationFolder="$(AddinDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Plugin copiado para $(AddinDir)" />
  </Target>

</Project>
