<?xml version="1.0" encoding="utf-8"?>
<!--
  Autoloader do Detalhador Estrutural Brasileiro para AutoCAD 2021 a 2027 (um componente por versão).
  Instalar em: %AppData%\Autodesk\ApplicationPlugins\DEB.bundle
  Estrutura:
    DEB.bundle\PackageContents.xml
    DEB.bundle\Contents\Windows\<ano>\DEB.AutoCAD.dll   (compilada para aquela versão)
    DEB.bundle\Contents\Windows\<ano>\DEB.Core.dll
  O AutoCAD carrega a DLL sozinho ao abrir (a pasta ApplicationPlugins é confiável,
  mesmo com SECURELOAD=1).
-->
<ApplicationPackage
    SchemaVersion="1.0"
    AppVersion="0.1.25"
    ProductCode="{E7509458-4339-448A-9FCF-F6286DD5E2D6}"
    UpgradeCode="{80A82AE8-94C2-4B27-8F8A-D2EE32E1AC67}"
    Name="Detalhador Estrutural Brasileiro"
    Description="Detalhador Estrutural Brasileiro: desenho, numeração e quantificação de armaduras."
    Author="Marquezin"
    ProductType="Application"
    HelpFile="./Contents/Help/INSTALACAO_AUTOCAD.txt">

  <CompanyDetails Name="Marquezin" />

  <RuntimeRequirements
      OS="Win64"
      Platform="AutoCAD*"
      SeriesMin="R24.0"
      SeriesMax="R26.0" />

  <Components Description="AutoCAD 2021">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.0" SeriesMax="R24.0" />
    <ComponentEntry
        AppName="ArmaduraBR"
        Version="0.1.25"
        ModuleName="./Contents/Windows/2021/DEB.AutoCAD.dll"
        AppDescription="Detalhador Estrutural Brasileiro"
        LoadOnAutoCADStartup="True"
        LoadOnCommandInvocation="False"
        LoadOnAppearance="False" />
  </Components>

  <Components Description="AutoCAD 2022">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.1" SeriesMax="R24.1" />
