<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plugin para ZWCAD (x64, .NET Framework 4.8). Os fontes da camada CAD ficam em ..\DEB.Cad
    (compartilhados com GstarCAD e AutoCAD); os namespaces ZwSoft.ZwCAD.* entram pelos "global using" de GlobalUsings.cs.
    Bibliotecas de referência: SDK oficial da ZWSOFT (ZRXSDK), guardadas em sdk\zwcad\<ano>\ref (só para compilar).
    Versão do ZWCAD: -p:ZwcadVersao=2024|2025|2026 (padrão 2026) → bin\ZWCAD<ano>\DEB.ZWCAD.dll
    Demo: -p:Demo=true → bin\demo\ZWCAD<ano>\
    Carregar no ZWCAD: NETLOAD da DLL (o instalador registra o carregamento automático).
  -->
  <PropertyGroup>
    <ZwcadVersao Condition="'$(ZwcadVersao)' == ''">2026</ZwcadVersao>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>DEB.ZWCAD</AssemblyName>
    <RootNamespace>DEB.Cad</RootNamespace>
    <DefineConstants>$(DefineConstants);ZWCAD;ZWCAD$(ZwcadVersao)</DefineConstants>
    <ZwRef>$(MSBuildThisFileDirectory)..\..\sdk\zwcad\$(ZwcadVersao)\ref</ZwRef>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\bin\ZWCAD$(ZwcadVersao)\</OutputPath>
    <DefineConstants Condition="'$(Demo)' == 'true'">$(DefineConstants);DEMO</DefineConstants>
    <OutputPath Condition="'$(Demo)' == 'true'">$(MSBuildThisFileDirectory)..\..\bin\demo\ZWCAD$(ZwcadVersao)\</OutputPath>
    <!-- obj separado por versão/demo -->
    <IntermediateOutputPath Condition="'$(Demo)' != 'true'">obj\$(ZwcadVersao)\$(Configuration)\</IntermediateOutputPath>
    <IntermediateOutputPath Condition="'$(Demo)' == 'true'">obj\demo$(ZwcadVersao)\$(Configuration)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.37</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ZwManaged">
      <HintPath>$(ZwRef)\ZwManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZwDatabaseMgd">
      <HintPath>$(ZwRef)\ZwDatabaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="GlobalUsings.cs" />
    <Compile Include="..\DEB.Cad\**\*.cs" LinkBase="Cad"
             Exclude="..\DEB.Cad\Infra\Autocompletar.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DEB.Core\DEB.Core.csproj" />
  </ItemGroup>

</Project>
