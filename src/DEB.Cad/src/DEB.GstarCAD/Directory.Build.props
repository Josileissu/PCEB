<Project>
  <!-- Lido antes do Microsoft.Common.props: pasta obj separada por versão do GstarCAD e pela demo
       (2026/2027 são .NET 8 e as outras .NET Framework: a restauração de uma não pode cair na pasta da outra). -->
  <PropertyGroup>
    <GstarVersao Condition="'$(GstarVersao)' == ''">2021</GstarVersao>
    <BaseIntermediateOutputPath Condition="'$(Demo)' != 'true'">obj\$(GstarVersao)\</BaseIntermediateOutputPath>
    <BaseIntermediateOutputPath Condition="'$(Demo)' == 'true'">obj\demo$(GstarVersao)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
