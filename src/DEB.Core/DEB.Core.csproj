    <Nullable>disable</Nullable>
    <RootNamespace>DEB.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- receitas de fábrica do motor (Motor/Receitas/ReceitasFabrica.cs) -->
