{
  "versao": 1,
  "tipoElemento": "bloco_estacas",
  "descricao": "Bloco sobre estacas (grade nx × ny ou triangular de 3), com cálice (colarinho ou embutido) ou arranque do pilar. Padrão BPM; exemplos B3, B4, B15, B28, B31.",
  "variaveis": [
    { "nome": "c", "formula": "padrao('cobrimento.solo', 4)" },
    { "nome": "cc", "formula": "padrao('cobrimento.calice', 2)" },
    { "nome": "emb_est", "formula": "max(0, embutimento_estaca)" },
    { "nome": "lastro_ef", "formula": "max(0, lastro)" },
    { "nome": "tri", "formula": "arranjo == 'Triangulo'" },
    { "nome": "cinco", "formula": "arranjo == 'Cinco'" },
    { "nome": "calice", "formula": "ligacao == 'CaliceColarinho' || ligacao == 'CaliceEmbutido'" },
    { "nome": "arranque", "formula": "ligacao == 'Arranque'" },
    { "nome": "uma_estaca", "formula": "!tri && estacas_x * estacas_y == 1" },
    { "nome": "colar", "formula": "ligacao == 'CaliceColarinho'" },
    { "nome": "h_colar", "formula": "se(colar, max(0, altura_colarinho), 0)" },
    { "nome": "h_total", "formula": "altura_base + h_colar" },
    { "nome": "emb_pilar", "formula": "se(calice, lemb, 0)" },
    { "nome": "reg", "formula": "se(calice, max(0, regularizacao), 0)" },
    { "nome": "z_inferior", "formula": "max(c, emb_est)" },
    { "nome": "perna_por_valor", "formula": "regra('principal.perna', 'altura_base') == 'valor' && padrao('principal.perna', 0) > 0" },
    { "nome": "pe_dentro", "formula": "regra('arranque.pe_sentido', 'fora') == 'dentro'" }
  ],
  "passos": [
    { "componente": "apoios_estacas", "nome": "estacas e contorno",
      "argumentos": { "arranjo": "se(tri, 'triangulo', se(cinco, 'cinco', 'grade'))", "nx": "estacas_x", "ny": "estacas_y", "esp_x": "esp_x", "esp_y": "esp_y", "dist_face": "dist_face" } },
    { "componente": "corpo_prismatico", "nome": "corpo do bloco",
      "argumentos": { "papel": "'bloco'", "contorno": "'contorno'", "z0": "0", "z1": "altura_base" } },
    { "componente": "calice_forma", "nome": "forma do cálice",
      "argumentos": { "ativo": "calice", "centro_x": "centro_apoios_x + pilar_ex", "centro_y": "centro_apoios_y + pilar_ey",
        "pilar_bx": "pilar_bx", "pilar_by": "pilar_by", "folga": "folga_calice", "parede": "parede_calice", "colarinho": "colar",
        "z_base_colarinho": "altura_base", "z_topo": "h_total", "embutimento": "emb_pilar", "regularizacao": "reg" } },
    { "componente": "corpo_prismatico", "nome": "pilar",
      "argumentos": { "ativo": "calice || arranque", "papel": "'pilar'",
        "x0": "centro_apoios_x + pilar_ex - pilar_bx / 2", "y0": "centro_apoios_y + pilar_ey - pilar_by / 2",
        "x1": "centro_apoios_x + pilar_ex + pilar_bx / 2", "y1": "centro_apoios_y + pilar_ey + pilar_by / 2",
        "z0": "se(calice, h_total - emb_pilar, h_total)", "z1": "h_total + 50" } },
    { "componente": "corpos_circulares", "nome": "estacas",
      "argumentos": { "papel": "'estaca'", "pontos": "'estacas'", "raio": "diam_estaca / 2",
        "z0": "-lastro_ef - max(25, 1.2 * diam_estaca)", "z1": "emb_est" } },
    { "componente": "corpo_prismatico", "nome": "concreto magro",
      "argumentos": { "ativo": "lastro_ef > 0", "papel": "'lastro'", "contorno": "'contorno'", "z0": "-lastro_ef", "z1": "0" } },
    { "componente": "niveis", "nome": "níveis",
      "argumentos": { "fundo": "0", "topo_base": "altura_base", "topo": "h_total" } },
    { "componente": "niveis", "nome": "nível do fundo do pilar",
      "argumentos": { "ativo": "calice", "fundo_pilar": "h_total - emb_pilar" } },
    { "componente": "niveis", "nome": "cota de arrasamento",
      "argumentos": { "arrasamento": "emb_est" } },

    { "componente": "bitola_efetiva", "nome": "bitola da lateral",
      "argumentos": { "funcao": "'lateral'", "posicao": "'lateral'", "variavel": "'bitola_lateral'" } },
    { "componente": "faixa_sobre_apoios", "nome": "principal",
      "argumentos": { "funcao": "'principal'", "chave": "'principal'", "nome": "'principal'",
        "linhas": "se(tri, 'lados', 'grade')", "cobrimento": "c", "recuo_lateral": "bitola_lateral / 10", "z_face": "z_inferior",
        "perna": "se(perna_por_valor, padrao('principal.perna', 0), floor(altura_base - c - z_inferior))",
        "regra_perna": "se(perna_por_valor, 'valor do perfil (principal.perna)', 'topo da base − cobrimento')",
        "limite_perna_z": "altura_base - c", "texto_limite_perna": "'do topo da base menos o cobrimento'",
        "regra_faixas": "'uma por linha de estacas'", "publicar_bitola": "'bitola_principal'", "publicar_topo": "'z_topo_inferior'" } },
    { "componente": "malha_face", "nome": "secundária x",
      "argumentos": { "funcao": "'secundaria'", "chave": "'secundaria_x'", "nome": "'secundária x'", "angulo": "0",
        "cobrimento": "c", "recuo_lateral": "bitola_lateral / 10", "z_face": "z_inferior + var('bitola_principal', 0) / 10 * 2",
        "camadas": "0", "perna": "padrao('secundaria.perna', 20)", "regra_perna": "'padrão do perfil (secundaria.perna)'",
        "publicar_topo": "'z_topo_inferior'" } },
    { "componente": "malha_face", "nome": "superior x",
      "argumentos": { "funcao": "'superior'", "chave": "'superior_x'", "nome": "'superior x'", "angulo": "0",
        "cobrimento": "c", "recuo_lateral": "bitola_lateral / 10", "z_face": "altura_base - c - bitola_lateral / 10",
        "superior": "1", "camadas": "0", "perna": "padrao('superior.perna', 20)", "regra_perna": "'padrão do perfil (superior.perna)'",
        "abertura": "se(calice, 'abertura', '')" } },
    { "componente": "malha_face", "nome": "secundária y",
      "argumentos": { "funcao": "'secundaria'", "chave": "'secundaria_y'", "nome": "'secundária y'", "angulo": "90",
        "cobrimento": "c", "recuo_lateral": "bitola_lateral / 10", "z_face": "z_inferior + var('bitola_principal', 0) / 10 * 2",
        "camadas": "1", "perna": "padrao('secundaria.perna', 20)", "regra_perna": "'padrão do perfil (secundaria.perna)'",
        "publicar_topo": "'z_topo_inferior'" } },
    { "componente": "malha_face", "nome": "superior y",
      "argumentos": { "funcao": "'superior'", "chave": "'superior_y'", "nome": "'superior y'", "angulo": "90",
        "cobrimento": "c", "recuo_lateral": "bitola_lateral / 10", "z_face": "altura_base - c - bitola_lateral / 10",
        "superior": "1", "camadas": "1", "perna": "padrao('superior.perna', 20)", "regra_perna": "'padrão do perfil (superior.perna)'",
        "abertura": "se(calice, 'abertura', '')" } },
    { "componente": "contorno_lateral", "nome": "lateral horizontal",
      "argumentos": { "funcao": "'lateral'", "chave": "'lateral'", "nome": "'lateral horizontal'", "cobrimento": "c", "z0": "0", "z1": "altura_base",
        "regra_quantidade": "'(altura da base − 2·cobrimento) / espaçamento'", "regra_contorno": "'contorno do bloco − cobrimento'" } },
    { "componente": "estribos_verticais", "nome": "estribos verticais",
      "argumentos": { "ativo": "!tri", "funcao": "'estribo_vertical'", "chave": "'estribo_vertical_x'", "nome": "'estribo vertical'",
        "cobrimento": "c", "comprimento": "largura_x", "largura": "largura_y", "z0": "emb_est", "altura": "altura_base - emb_est",
        "regra_quantidade": "'(comprimento − 2·cobrimento) / espaçamento, fora do cálice'",
        "regra_largura": "'largura do bloco − 2·cobrimento'", "regra_altura": "'altura da base − embutimento da estaca − 2·cobrimento (acima da cabeça das estacas)'",
        "excluir_x0": "var('calice_colarinho_x0', -1)", "excluir_x1": "var('calice_colarinho_x1', -1)" } },
    { "componente": "estribos_verticais", "nome": "estribos verticais em y (bloco de 1 estaca)",
      "argumentos": { "ativo": "uma_estaca", "direcao": "'y'", "funcao": "'estribo_vertical'", "chave": "'estribo_vertical_y'", "nome": "'estribo vertical (y)'",
        "cobrimento": "c", "comprimento": "largura_y", "largura": "largura_x", "z0": "emb_est", "altura": "altura_base - emb_est",
        "regra_quantidade": "'(comprimento − 2·cobrimento) / espaçamento'",
        "regra_largura": "'largura do bloco − 2·cobrimento'", "regra_altura": "'altura da base − embutimento da estaca − 2·cobrimento (acima da cabeça das estacas)'" } },

    { "componente": "calice_armaduras", "nome": "armaduras do cálice",
      "argumentos": { "ativo": "calice", "colarinho": "colar", "cobrimento": "c", "cobrimento_calice": "cc", "parede": "parede_calice",
        "centro_x": "centro_apoios_x + pilar_ex", "centro_y": "centro_apoios_y + pilar_ey", "z_topo": "h_total", "embutimento": "emb_pilar",
        "regularizacao": "reg", "z_topo_inferior": "var('z_topo_inferior', c)", "grampos": "padrao('calice.grampos', 1) != 0",
        "desconto_perna_externa": "padrao('suspensao.desconto_perna_externa', 6)",
        "regra_desconto": "'perna − desconto do perfil (suspensao.desconto_perna_externa)'",
        "comprimento_fundo": "padrao('fundo_calice.comprimento', 100)", "regra_comprimento_fundo": "'padrão do perfil (fundo_calice.comprimento)'" } },
    { "componente": "arranque", "nome": "arranque do pilar",
      "argumentos": { "ativo": "arranque", "centro_x": "centro_apoios_x + pilar_ex", "centro_y": "centro_apoios_y + pilar_ey",
        "pilar_bx": "pilar_bx", "pilar_by": "pilar_by", "nx": "arranque_nx", "ny": "arranque_ny", "cobrimento_pilar": "arranque_cobrimento",
        "cobrimento": "c", "z_topo": "h_total", "z_topo_inferior": "var('z_topo_inferior', c)", "fck": "fck",
        "regra_comprimento_interno": "'topo do bloco − topo da armadura inferior'",
        "espera": "padrao('arranque.espera', 0)", "regra_espera": "'padrão do perfil (arranque.espera)'",
        "pe": "padrao('arranque.pe', 20)", "regra_pe": "'padrão do perfil (arranque.pe)'", "pe_dentro": "pe_dentro",
        "regra_pe_sentido": "se(pe_dentro, 'para dentro (perfil arranque.pe_sentido)', 'para fora (perfil arranque.pe_sentido)')" } },

    { "componente": "verificacoes_geometria", "nome": "verificações da geometria",
      "argumentos": { "dist_face": "dist_face", "raio_apoio": "diam_estaca / 2", "centro_x": "centro_apoios_x + pilar_ex", "centro_y": "centro_apoios_y + pilar_ey",
        "pilar_bx": "pilar_bx", "pilar_by": "pilar_by", "texto_pilar_fora": "'O pilar sai do bloco.'" } },
    { "componente": "verificacoes_calice", "nome": "verificações do cálice (NBR 9062)",
      "argumentos": { "ativo": "calice", "pilar_bx": "pilar_bx", "pilar_by": "pilar_by", "embutimento": "emb_pilar",
        "interface": "se(interface == 'Chaves', 'chaves', se(interface == 'Rugosa', 'rugosa', 'lisa'))",
        "colarinho": "colar", "parede": "parede_calice", "z_topo": "h_total", "regularizacao": "reg" } },
    { "componente": "aviso", "nome": "aviso do triangular",
      "argumentos": { "ativo": "tri && tem('estribo_vertical')",
        "texto": "'Bloco triangular: estribos verticais da base não são gerados (só a lateral horizontal em volta).'" } }
  ],
  "verificacoes": []
}
