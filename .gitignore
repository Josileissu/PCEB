# Biblioteca: material com direitos autorais NÃO vai para o repositório.
# A pasta existe no Git só com o LEIAME e a lista de nomes; cada usuário alimenta a sua cópia local.
docs/02_biblioteca/normas/*
!docs/02_biblioteca/normas/LEIAME.md
!docs/02_biblioteca/normas/NORMAS_REFERENCIA.txt
docs/02_biblioteca/livros/*
docs/02_biblioteca/artigos/*
docs/02_biblioteca/padroes-escritorio/*
!docs/02_biblioteca/*/.gitkeep

# Downloads de programas de terceiros (cada um tem a sua licença e origem registradas no NOTAS.md)
programas/*/download/

# Gerais
*.tmp
~$*
Thumbs.db

# Saídas de compilação (todos os projetos)
bin/
obj/
