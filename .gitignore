# compilação
bin/
obj/
*.user
.vs/

# instaladores gerados (gerar de novo com instalador\gerar.bat)
instalador/saida/

# arquivos de projetos do escritório e especificação (fora do repositório, decisão do usuário)
auxiliar_cad/
info_auxiliar/

# temporários do CAD
*.bak
*.cad-bak
*.dwl
*.dwl2
*.sv$

# SDK do ZWCAD (ZWSOFT, ZRXSDK): os instaladores e as extrações completas ficam só na máquina;
# no Git vão as bibliotecas .NET de referência de cada versão (sdk/zwcad/<ano>/ref)
sdk/*.exe
sdk/zwcad/*/ZWCAD_*/
